<Window x:Class="Dusk.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dusk"
        Width="424"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Sans}"
        FontSize="14"
        Foreground="{StaticResource Ink}">
    <Grid x:Name="Root" Margin="16" RenderTransformOrigin="1,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" />
                <TranslateTransform x:Name="RootShift" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="28" Background="{StaticResource Paper}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="28" Background="{StaticResource Paper}" />
        <Border CornerRadius="28">
            <Border.Background>
                <RadialGradientBrush Center="0.12,0" GradientOrigin="0.12,0" RadiusX="0.9" RadiusY="0.55">
                    <GradientStop Color="#3B8FA2FF" Offset="0" />
                    <GradientStop Color="#008FA2FF" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border CornerRadius="28">
            <Border.Background>
                <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="0.8" RadiusY="0.5">
                    <GradientStop Color="#693A4150" Offset="0" />
                    <GradientStop Color="#003A4150" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border CornerRadius="28" BorderThickness="1" BorderBrush="{StaticResource Edge}" />

        <StackPanel Margin="20">
            <Grid Margin="4,2,4,4">
                <TextBlock Text="Dusk" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StateText" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ToggleButton x:Name="EnabledSwitch" Style="{StaticResource Switch}" Click="OnEnabledClick" ToolTip="Turn all adjustments on or off" />
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="MonitorList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,12,0,0" CornerRadius="22" Padding="24" Background="{StaticResource GlassNormal}" BorderThickness="1" BorderBrush="{StaticResource Edge}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" ToolTip="{Binding Tip}" Style="{StaticResource Tile}" Width="28" Padding="0" Margin="0,0,6,0" FontFamily="{StaticResource Mono}" Click="OnTileClick" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding SaveText}" Style="{StaticResource GhostButton}" Height="28" Padding="10,0" FontSize="12" Click="OnSaveClick" ToolTip="Press, then pick 1, 2, 3 or the filter to store the current values there" />
                                    </StackPanel>
                                    <Button DataContext="{Binding Filter}" Content="{Binding Label}" ToolTip="{Binding Tip}" Style="{StaticResource Tile}" Padding="12,0" HorizontalAlignment="Right" Click="OnTileClick" />
                                </Grid>

                                <Grid Margin="0,18,0,6">
                                    <TextBlock Text="Temperature" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkSoft}" />
                                    <TextBlock Text="{Binding KelvinText}" FontFamily="{StaticResource Mono}" FontSize="13" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Style="{StaticResource DuskSlider}" Minimum="1200" Maximum="9000" SmallChange="100" LargeChange="500" Value="{Binding Kelvin, Mode=TwoWay}" />

                                <Grid Margin="0,14,0,6">
                                    <TextBlock Text="Brightness" FontSize="13" FontWeight="Medium" Foreground="{StaticResource InkSoft}" />
                                    <TextBlock Text="{Binding BrightnessText}" FontFamily="{StaticResource Mono}" FontSize="13" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Style="{StaticResource DuskSlider}" Minimum="10" Maximum="100" SmallChange="1" LargeChange="5" Value="{Binding Brightness, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="HintText" Margin="6,16,6,0" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18" />
            <TextBlock x:Name="WarnText" Margin="6,8,6,0" FontSize="12" Foreground="#F0B26B" TextWrapping="Wrap" LineHeight="18" Visibility="Collapsed" />

            <Grid Margin="4,16,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="OnAutostartClick" />
                    <TextBlock Text="Start with Windows" FontSize="13" Foreground="{StaticResource InkSoft}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Quit" Style="{StaticResource GhostButton}" Click="OnQuitClick" />
                    <Button Content="Reset" Style="{StaticResource SecondaryButton}" Click="OnResetClick" Margin="6,0,0,0" ToolTip="Set every screen back to 6500 K and 100 %" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
